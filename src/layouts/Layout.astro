---
import bricolageWoff from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import interWoff from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" as="font" type="font/woff2" href={bricolageWoff} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interWoff} crossorigin="anonymous" />
    <link rel="icon" type="image/webp" sizes="96x96" href="/favicon.webp" />
    <link rel="icon" type="image/webp" sizes="48x48" href="/favicon-48.webp" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#dc2626" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.webp" />
    <title>Lechonería Los Tres Cerditos | Lechonas en Cali</title>
    <meta
      name="description"
      content="Descubre por qué somos las mejores lechonas de Cali. Sabor 100% tradicional, cuero extra crocante y pedidos a domicilio en toda la ciudad. ¡Llámanos ya!"
    />
    <meta
      name="keywords"
      content="lechonas en cali, Lechoneria Los Tres Cerditos, mejores lechonas cali, lechona a domicilio cali, lechoneria comuna 8"
    />

    <link rel="canonical" href="https://lechonatrescerditos.com/" />

    <meta
      property="og:title"
      content="Lechoneria Los Tres Cerditos - Las Mejores Lechonas en Cali"
    />
    <meta
      property="og:description"
      content="Tradición familiar y sabor auténtico en Cali. Cuero extra crocante y pedidos a domicilio. ¡Llámanos y lleva la mejor lechona a tu mesa!"
    />
    <meta
      property="og:image"
      content="https://lechonatrescerditos.com/og-image.webp"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://lechonatrescerditos.com" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Lechoneria Los Tres Cerditos - Las Mejores Lechonas en Cali"
    />
    <meta
      name="twitter:description"
      content="Tradición familiar y sabor auténtico en Cali. Cuero extra crocante y pedidos a domicilio. ¡Llámanos y lleva la mejor lechona a tu mesa!"
    />
    <meta
      name="twitter:image"
      content="https://lechonatrescerditos.com/og-image.webp"
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Restaurant",
        "name": "Lechonas Los Tres Cerditos",
        "alternateName": "Lechonería Los Tres Cerditos",
        "image": "https://lechonatrescerditos.com/og-image.webp",
        "description": "Lechonería tradicional en Cali con la receta secreta de la familia. Venta directa sábados, domingos y festivos desde las 10:00 AM hasta agotar existencias; de lunes a viernes se atienden encargos y cotizaciones bajo pedido, llamando previamente.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Cra. 23 #33Ebis-111",
          "addressLocality": "Cali",
          "addressRegion": "Valle del Cauca",
          "postalCode": "760010",
          "addressCountry": "CO"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 3.437878,
          "longitude": -76.509231
        },
        "url": "https://lechonatrescerditos.com",
        "telephone": "+573137086162",
        "sameAs": [
          "https://www.facebook.com/lechoneria.los.tres.cerditos.731823",
          "https://www.instagram.com/lechonerialostrescerditos_cali/"
        ],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Saturday", "Sunday", "PublicHoliday"],
            "opens": "10:00",
            "closes": "18:00"
          }
        ],
        "priceRange": "$$",
        "servesCuisine": "Tradicional Colombiana",
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.5",
          "reviewCount": "91"
        },
        "review": [
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Elizabeth Gómez Martínez" },
            "reviewBody": "Deliciosa lechona, el sabor es muy rico, tiene buena arveja y bastante carnuda, me parece que el sabor no es empalagoso como en otros lugares que he probado."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Carlos González" },
            "reviewBody": "Es una excelente lechona, la mejor de Cali, cuero tostadito y carne pulpa sin gordo. Nos encantó a todos, la recomiendo a ojos cerrados."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Diana Ruiz" },
            "reviewBody": "Muy deliciosa la lechona."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Heiner Granada" },
            "reviewBody": "Las mejores lechonas de Cali, del mundo y sus alrededores. Excelente atención, ubicación central. Relación costo-beneficio insuperable."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Daniela Cataño Medina" },
            "reviewBody": "Es deliciosa. En el local entregan para llevar o a domicilio."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Andrés Quesada" },
            "reviewBody": "Excelente el producto, muy delicioso y bien cargado. La atención por parte de sus dueños es muy buena, si vas a hacer negocio te la recomiendo 100%."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Andrea Renteria" },
            "reviewBody": "Pedí 90 cajas de lechona, llegaron muy puntuales y sabía rica."
          },
          {
            "@type": "Review",
            "author": { "@type": "Person", "name": "Hernán Orbes" },
            "reviewBody": "Un gran lugar con una lechona de rechupete y un servicio muy bueno y un ambiente bien."
          }
        ]
      }
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-brand-600 focus:text-white focus:px-5 focus:py-3 focus:rounded-pill"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
  }

  html {
    scroll-behavior: smooth; /* */
  }

  /* Scrollbar Minimalista */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #18181b;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--color-brand-500);
    border-radius: 10px;
  }

  #contact-fab-container.is-hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }
</style>

<script>
  import "../scripts/motion";
</script>
