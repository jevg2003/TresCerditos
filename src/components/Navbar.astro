---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
---
<nav id="main-nav" class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-xl border-b border-zinc-200 transition-transform duration-300">
  <div class="w-full px-6 md:px-12 h-20 md:h-24 flex items-center justify-between">
    <a href="#inicio" class="flex flex-1 md:flex-none items-center justify-between md:justify-start gap-3 md:gap-5 group cursor-pointer h-full py-2">
      <Image src={logo} alt="Lechonería Los Tres Cerditos" width={96} height={96} loading="eager" class="h-full w-auto object-contain group-hover:scale-105 transition-transform" />
      <div class="hidden md:flex items-baseline gap-2">
        <span class="font-black text-2xl md:text-3xl tracking-tighter text-zinc-900 uppercase leading-none">
          Lechoneria
        </span>
        <span class="font-bold text-lg md:text-xl tracking-tight text-brand-600 uppercase leading-none">
          Tres Cerditos
        </span>
      </div>
    </a>
    
    <div class="hidden md:flex items-center gap-4 lg:gap-10 text-xs font-black uppercase tracking-widest text-zinc-600">
      <a href="#inicio" class="hover:text-brand-600 transition-colors">Inicio</a>
      <a href="#productos" class="hover:text-brand-600 transition-colors">Menú</a>
      <a href="#nosotros" class="hover:text-brand-600 transition-colors">Nosotros</a>
      <a href="#galeria" class="hover:text-brand-600 transition-colors">Galería</a>
      <a href="#ubicacion" class="hover:text-brand-600 transition-colors">Ubicación</a>
      <a href="#contacto" class="bg-brand-600 text-white px-8 py-3 rounded-full hover:shadow-[0_0_20px_oklch(0.577_0.245_27.325_/_0.4)] hover:scale-105 transition">Pedir</a>
    </div>

    <button class="md:hidden relative w-10 h-10 flex items-center justify-center group" id="menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <div class="flex flex-col gap-1.5 w-6 transition duration-300" id="hamburger-icon">
        <span class="w-full h-1 bg-brand-600 rounded-full transition duration-300 origin-center line-1"></span>
        <span class="w-full h-1 bg-brand-600 rounded-full transition duration-300 line-2"></span>
        <span class="w-full h-1 bg-brand-600 rounded-full transition duration-300 origin-center line-3"></span>
      </div>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden absolute top-24 left-0 w-full bg-white/95 backdrop-blur-2xl border-b border-zinc-200 p-8 space-y-6 shadow-2xl origin-top transition duration-300 opacity-0 -translate-y-4">
    <div class="flex flex-col gap-6 text-center">
      <a href="#inicio" class="nav-link-mobile text-xl font-black text-zinc-900 uppercase italic tracking-tighter hover:text-brand-600 transition-colors">Inicio</a>
      <a href="#productos" class="nav-link-mobile text-xl font-black text-zinc-900 uppercase italic tracking-tighter hover:text-brand-600 transition-colors">Menú</a>
      <a href="#galeria" class="nav-link-mobile text-xl font-black text-zinc-900 uppercase italic tracking-tighter hover:text-brand-600 transition-colors">Galería</a>
      <a href="#ubicacion" class="nav-link-mobile text-xl font-black text-zinc-900 uppercase italic tracking-tighter hover:text-brand-600 transition-colors">Ubicación</a>
      <a href="#nosotros" class="nav-link-mobile text-xl font-black text-zinc-900 uppercase italic tracking-tighter hover:text-brand-600 transition-colors">Nosotros</a>
      <a href="#contacto" class="nav-link-mobile bg-brand-600 text-white p-4 rounded-2xl text-center font-black uppercase tracking-widest shadow-lg shadow-brand-600/40 active:scale-95 transition">Pedir Ahora</a>
    </div>
  </div>
</nav>

<style>
  :global(body.overflow-hidden) {
    overflow: hidden;
  }

  /* Hamburger-to-X animation */
  #menu-btn.is-open .line-1 {
    transform: translateY(10px) rotate(45deg);
  }
  #menu-btn.is-open .line-2 {
    opacity: 0;
    transform: translateX(10px);
  }
  #menu-btn.is-open .line-3 {
    transform: translateY(-10px) rotate(-45deg);
  }

  #mobile-menu.show {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }
  .nav-hidden {
    transform: translateY(-100%);
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.nav-link-mobile');
  const body = document.body;

  function toggleMenu() {
    const isOpen = btn?.classList.toggle('is-open');
    btn?.setAttribute('aria-expanded', String(!!isOpen));
    btn?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

    if (isOpen) {
      body.classList.add('overflow-hidden');
      menu?.classList.remove('hidden');
      setTimeout(() => menu?.classList.add('show'), 10);
    } else {
      body.classList.remove('overflow-hidden');
      menu?.classList.remove('show');
      setTimeout(() => menu?.classList.add('hidden'), 300);
      (btn as HTMLElement | null)?.focus();
    }
  }

  btn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      if (btn?.classList.contains('is-open')) toggleMenu();
    });
  });

  // Close the mobile menu if the viewport grows past the md breakpoint while it's open.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      if (btn?.classList.contains('is-open')) {
        toggleMenu();
      }
    }
  });
</script>