---
import { Image } from "astro:assets";
import { galleryMedia } from "../lib/media";
---

<section
  id="galeria"
  class="py-10 md:py-16 bg-white overflow-hidden"
  data-reveal
>
  <div class="w-full">
    <div
      class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6 px-6 md:px-12"
    >
      <div class="text-center md:text-left">
        <h2
          class="text-4xl md:text-6xl font-bold uppercase tracking-tight text-zinc-900"
        >
          Nuestra <span class="text-brand-700">Galería</span>
        </h2>

      </div>

      <div
        class="flex items-center justify-center md:justify-end gap-3"
        id="gallery-controls"
      >
        <button
          id="master-pause"
          class="control-box active:scale-95 cursor-pointer hover:bg-zinc-200 transition-colors"
          aria-label="Alternar pausa o reproducción de la galería automática"
        >
          <div
            class="relative w-6 h-6 flex items-center justify-center text-brand-700"
          >
            <svg
              id="pause-icon"
              class="w-6 h-6 text-brand-700 font-bold"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <svg
              id="play-icon"
              class="w-6 h-6 text-brand-700 font-bold hidden"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <span
            class="text-xs font-black uppercase tracking-[0.2em] text-zinc-600"
            id="pause-text">Pausar</span
          >
        </button>

        <div class="control-box font-bold">
          <span
            id="current-index-display"
            class="text-2xl font-black text-brand-700 italic leading-none"
            >01</span
          >
          <div class="w-px h-6 bg-zinc-300"></div>
          <span
            class="text-sm font-bold text-zinc-400 uppercase tracking-widest leading-none"
            >{galleryMedia.length.toString().padStart(2, "0")}</span
          >
        </div>
      </div>
    </div>

    <div
      id="gallery-observer-target"
      class="relative group w-full h-[45vh] md:h-[55vh] max-h-[600px] overflow-hidden bg-black border-y border-zinc-200 touch-pan-y cursor-grab active:cursor-grabbing"
      tabindex="0"
      role="region"
      aria-label="Galería de fotos y videos"
    >
      <!-- IMAGE ELEMENT -->
      {
        galleryMedia.length > 0 && (
          <img
            id="main-stage"
            src={
              galleryMedia[0].kind === "image" ? galleryMedia[0].src.src : ""
            }
            alt=""
            draggable="false"
            class:list={[
              "relative w-full h-full object-contain transition-all duration-700 ease-in-out z-10 hover:scale-105 select-none",
              galleryMedia[0].kind === "video" && "hidden",
            ]}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        )
      }

      <!-- VIDEO ELEMENT -->
      {
        galleryMedia.length > 0 && (
          <video
            id="main-video"
            src={galleryMedia[0].kind === "video" ? galleryMedia[0].src : ""}
            class={`relative w-full h-full object-contain z-10 ${galleryMedia[0].kind === "video" ? "" : "hidden"}`}
            muted
            loop
            playsinline
          />
        )
      }

      <div
        class="absolute inset-0 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-500 hidden md:flex items-center justify-between px-8 pointer-events-none"
      >
        <button
          id="prev-btn"
          class="pointer-events-auto w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-xl border border-white/20 text-white flex items-center justify-center -translate-x-10 group-hover:translate-x-0 opacity-0 group-hover:opacity-100 transition-all duration-500 hover:bg-brand-700"
          aria-label="Ver imagen anterior de la galería"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M15 19l-7-7 7-7"></path></svg
          >
        </button>
        <button
          id="next-btn"
          class="pointer-events-auto w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-xl border border-white/20 text-white flex items-center justify-center translate-x-10 group-hover:translate-x-0 opacity-0 group-hover:opacity-100 transition-all duration-500 hover:bg-brand-700"
          aria-label="Ver siguiente imagen de la galería"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M9 5l7 7-7 7"></path></svg
          >
        </button>
      </div>

      <div
        class="absolute bottom-0 left-0 h-1.5 bg-brand-700 z-40 transition-all ease-linear w-0"
        id="progress-bar"
      >
      </div>
    </div>

    <p id="gallery-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

    <div
      class="mt-6 md:mt-12 relative w-full group/thumbs flex items-center justify-center"
    >
      <div
        id="thumb-container"
        class="grid grid-rows-2 grid-flow-col md:flex md:flex-row md:justify-start gap-2 sm:gap-3 md:gap-4 overflow-x-auto overflow-y-hidden pb-4 pt-2 px-6 md:px-12 w-full custom-scrollbar relative z-0"
        style="-webkit-overflow-scrolling: touch;"
      >
        {
          galleryMedia.map((media, index) => (
            <button
              class="thumb-btn flex-shrink-0 w-24 h-20 sm:w-28 sm:h-24 md:w-36 md:h-24 rounded-card overflow-hidden relative transition-all duration-300 opacity-60 hover:opacity-100 border-2 border-transparent bg-zinc-100"
              data-src={media.kind === "image" ? media.src.src : media.src}
              data-type={media.kind === "image" ? "img" : "video"}
              data-index={index}
              aria-label={`Ver elemento ${index + 1} de ${galleryMedia.length}`}
              aria-current={index === 0 ? "true" : "false"}
            >
              {media.kind === "video" ? (
                <div class="w-full h-full relative">
                  <img
                    src={media.poster}
                    alt={media.alt}
                    class="w-full h-full object-cover pointer-events-none"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 flex items-center justify-center bg-black/40">
                    <svg
                      class="w-6 h-6 md:w-8 md:h-8 text-white"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path d="M4 4l12 6-12 6z" />
                    </svg>
                  </div>
                </div>
              ) : (
                <Image
                  src={media.src}
                  width={288}
                  height={192}
                  format="webp"
                  alt={media.alt}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover pointer-events-none"
                />
              )}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .control-box {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.75rem;
    min-height: 3.5rem;
    background-color: var(--color-zinc-100);
    border-radius: 1.25rem;
    border: 1px solid var(--color-zinc-200);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--color-brand-600);
    border-radius: 10px;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .thumb-btn.is-active {
    opacity: 1 !important;
    border-color: var(--color-brand-600);
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 10px 20px -5px oklch(0.577 0.245 27.325 / 0.4);
    z-index: 10;
  }
</style>

<script>
  const thumbBtns = document.querySelectorAll(".thumb-btn");
  const mainImg = document.getElementById("main-stage") as HTMLImageElement;
  const mainVideo = document.getElementById("main-video") as HTMLVideoElement;
  const progressBar = document.getElementById("progress-bar");
  const container = document.getElementById("thumb-container");
  const indexDisplay = document.getElementById("current-index-display");
  const galleryBox = document.getElementById("gallery-observer-target");

  const pauseBtn = document.getElementById("master-pause");
  const pauseText = document.getElementById("pause-text");
  const pauseIcon = document.getElementById("pause-icon");
  const playIcon = document.getElementById("play-icon");

  const prevBtn = document.getElementById("prev-btn");
  const nextBtn = document.getElementById("next-btn");
  const galleryStatus = document.getElementById("gallery-status");

  const SLIDE_DURATION_MS = 6000;

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  let currentIndex = 0;
  let interval: any;
  let isPaused = prefersReducedMotion;
  let isVisible = false;
  let touchStartX = 0;
  let isUserInteracting = false;
  let interactionTimeout: any;

  function setInteracting() {
    isUserInteracting = true;
    clearTimeout(interactionTimeout);
    interactionTimeout = setTimeout(() => {
      isUserInteracting = false;
    }, 3000); // 3 segundos sin tocar para retomar el scroll automático
  }

  container?.addEventListener("mousedown", setInteracting);
  container?.addEventListener("touchstart", setInteracting, { passive: true });
  container?.addEventListener("wheel", setInteracting, { passive: true });

  function updateGallery(index: number, isManual = false, isInit = false) {
    if (isManual) setInteracting();
    currentIndex = index;
    const btn = thumbBtns[index];
    if (!btn) return;
    const newSrc = btn.getAttribute("data-src");
    const type = btn.getAttribute("data-type");

    if (mainVideo) mainVideo.pause();

    if (!isPaused) startAutoPlay();

    if (indexDisplay) {
      indexDisplay.textContent = (index + 1).toString().padStart(2, "0");
    }

    if (type === "video") {
      if (mainImg) mainImg.classList.add("hidden");
      if (mainVideo && newSrc) {
        mainVideo.classList.remove("hidden");
        mainVideo.src = newSrc;
        if (!isPaused && isVisible) {
          mainVideo.play().catch((e) => console.log("Auto-play prevent:", e));
        }
      }
    } else {
      if (mainVideo) mainVideo.classList.add("hidden");
      if (mainImg && newSrc) {
        mainImg.classList.remove("hidden");
        // Pre-cambiar SRC sin timeout para instantaneidad
        mainImg.src = newSrc;
      }
    }

    thumbBtns.forEach((b) => {
      b.classList.remove("is-active");
      b.setAttribute("aria-current", "false");
    });
    btn.classList.add("is-active");
    btn.setAttribute("aria-current", "true");

    if (galleryStatus && !isInit) {
      galleryStatus.textContent = `Elemento ${index + 1} de ${thumbBtns.length}`;
    }

    // Reemplazo de scrollIntoView para evitar que el navegador mueva TODA la web
    if (container && !isUserInteracting && !isInit) {
      const btnEl = btn as HTMLElement;
      const scrollPos =
        btnEl.offsetLeft - container.offsetWidth / 2 + btnEl.offsetWidth / 2;
      container.scrollTo({ left: scrollPos, behavior: "smooth" });
    }

    // Precarga inteligente por JS (prevé warnings)
    const preloadIdxs = [
      (index + 1) % thumbBtns.length,
      (index - 1 + thumbBtns.length) % thumbBtns.length,
    ];
    preloadIdxs.forEach((idx) => {
      const pBtn = thumbBtns[idx];
      if (pBtn && pBtn.getAttribute("data-type") === "img") {
        const url = pBtn.getAttribute("data-src");
        if (url) new Image().src = url;
      }
    });

    if (progressBar) {
      progressBar.style.transition = "none";
      progressBar.style.width = "0%";
      if (!isPaused && isVisible) {
        setTimeout(() => {
          progressBar.style.transition = `width ${SLIDE_DURATION_MS}ms linear`;
          progressBar.style.width = "100%";
        }, 50);
      }
    }
  }

  function startAutoPlay() {
    clearInterval(interval);
    if (isPaused) return;
    interval = setInterval(() => {
      if (isVisible && !isPaused) {
        currentIndex = (currentIndex + 1) % thumbBtns.length;
        updateGallery(currentIndex);
      }
    }, SLIDE_DURATION_MS);
  }

  function stopAutoPlay() {
    if (interval) clearInterval(interval);
  }

  pauseBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    isPaused = !isPaused;

    pauseIcon?.classList.toggle("hidden", isPaused);
    playIcon?.classList.toggle("hidden", !isPaused);

    if (pauseText) {
      pauseText.textContent = isPaused ? "Reanudar" : "Pausar";
    }

    if (isPaused) {
      stopAutoPlay();
      if (progressBar) progressBar.style.width = "0%";
      if (mainVideo) mainVideo.pause();
    } else {
      startAutoPlay();
      updateGallery(currentIndex);
    }
  });

  galleryBox?.addEventListener(
    "touchstart",
    (e: any) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true },
  );
  galleryBox?.addEventListener(
    "touchend",
    (e: any) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) currentIndex = (currentIndex + 1) % thumbBtns.length;
        else
          currentIndex =
            (currentIndex - 1 + thumbBtns.length) % thumbBtns.length;
        updateGallery(currentIndex);
      }
    },
    { passive: true },
  );

  prevBtn?.addEventListener("click", () => {
    currentIndex = (currentIndex - 1 + thumbBtns.length) % thumbBtns.length;
    updateGallery(currentIndex, true);
  });
  nextBtn?.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % thumbBtns.length;
    updateGallery(currentIndex, true);
  });
  thumbBtns.forEach((btn, i) =>
    btn.addEventListener("click", () => updateGallery(i, true)),
  );

  galleryBox?.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "ArrowLeft") {
      currentIndex = (currentIndex - 1 + thumbBtns.length) % thumbBtns.length;
      updateGallery(currentIndex, true);
    } else if (e.key === "ArrowRight") {
      currentIndex = (currentIndex + 1) % thumbBtns.length;
      updateGallery(currentIndex, true);
    } else {
      return;
    }
    e.preventDefault();
  });

  // Control over visibility for video playback and autoplay
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
        if (isVisible) {
          if (!isPaused) {
            // Re-sincronizar timer y barra roja al volver a la pantalla
            updateGallery(currentIndex, false, true);
          }
        } else {
          stopAutoPlay();
          if (mainVideo) mainVideo.pause();
          // Detener físicamente la barra roja para que no siga cargando de forma fantasma
          if (progressBar) {
            progressBar.style.transition = "none";
            progressBar.style.width = "0%";
          }
        }
      });
    },
    { threshold: 0.3 },
  ); // Pausar rigurosamente cuando se scrollea fuera (30% visibilidad)

  if (galleryBox) observer.observe(galleryBox);

  if (isPaused) {
    pauseIcon?.classList.add("hidden");
    playIcon?.classList.remove("hidden");
    if (pauseText) pauseText.textContent = "Reanudar";
  }

  // Initialize sin scroll inicial
  setTimeout(() => updateGallery(0, false, true), 100);
</script>
