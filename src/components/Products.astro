---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import img05 from "../assets/images/imagen-05.jpg";
import img03 from "../assets/images/imagen-03.jpg";
import img02 from "../assets/images/imagen-02.jpg";
import img40 from "../assets/images/imagen-40.jpeg";
import img24 from "../assets/images/imagen-24.jpg";
import img26 from "../assets/images/imagen-43.jpg";

interface Producto {
  nombre: string;
  desc: string;
  imagen: ImageMetadata;
}

const productos: Producto[] = [
  {
    nombre: "Lechona Tradicional",
    desc: "Nuestra receta auténtica tolimense con arroz seleccionado, jugosa carne de cerdo desmechada y el característico cuero crocante horneado a la perfección.",
    imagen: img05,
  },
  {
    nombre: "Cojín de Lechona",
    desc: "El formato ideal para compartir o celebrar eventos especiales. Lechona empacada, lista para dividir en porciones de manera muy práctica.",
    imagen: img03,
  },
  {
    nombre: "Pernil de Cerdo",
    desc: "Exquisito pernil de cerdo horneado lentamente en sus propios jugos y finas hierbas, garantizando una carne muy suave, tierna y con mucho sabor a hogar.",
    imagen: img02,
  },
  {
    nombre: "Papa Rellena",
    desc: "Una fusión increíble y deliciosa: crujiente masa de papa por fuera, rellena generosamente con nuestra inconfundible lechona de la casa por dentro.",
    imagen: img40,
  },
  {
    nombre: "Empanada",
    desc: "Pequeñas delicias con la masa de maíz más crujiente dorada en su punto, conservando todo el sabor auténtico de la lechona en cada bocado rápido.",
    imagen: img24,
  },
  {
    nombre: "Tamal con Lechona",
    desc: "La combinación perfecta y preferida por muchísimos clientes. Delicioso tamal tolimense acompañado con una generosa porción de nuestra mejor lechona.",
    imagen: img26,
  },
];
---

<section id="productos" class="py-20" data-reveal>
  <h2 class="text-4xl md:text-6xl font-bold mb-12 uppercase tracking-tight text-center md:text-left">
    Nuestros <span class="text-red-600">Manjares</span>
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      productos.map((p) => (
        <div class="bg-zinc-50 p-3 rounded-card border border-zinc-200 hover:shadow-2xl transition-all group flex flex-col h-full">
          <div class="h-64 bg-zinc-200 rounded-card overflow-hidden relative shrink-0">
            <Image
              src={p.imagen}
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
              format="webp"
              alt={`${p.nombre} — Lechonería Los Tres Cerditos, Cali`}
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <h3 class="text-2xl font-bold">{p.nombre}</h3>
            <p class="text-ink-700 text-sm mt-3 leading-relaxed flex-grow">
              {p.desc}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
